	"scripts": {
		"dev": "vite dev",
		"dev:tauri": "tauri dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"test:all": "pnpm test:unit:ci && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:performance": "playwright test --config playwright.performance.config.ts",
		"check:performance": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.performance.json",
		"test:unit:ci": "vitest --run",
		"test": "vitest",
		"lint": "oxfmt --check . && oxlint .",
		"lint:fix": "oxlint . --fix && oxfmt --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"license": "MIT",
