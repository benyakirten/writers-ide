{
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"fixKind": "safe_fix"
				}
			}
		}
	},
	"languages": {
		"JavaScript": {
			"language_servers": ["oxlint", "oxfmt", "...", "!eslint"],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},

		"TypeScript": {
			"language_servers": ["oxlint", "oxfmt", "...", "!eslint"],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},

		"Svelte": {
			"language_servers": ["oxlint", "oxfmt", "...", "!eslint"],
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": [
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"JSON": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},
		"JSONC": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},

		"HTML": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},
		"CSS": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},

		"Markdown": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		},

		"YAML": {
			"format_on_save": "on",
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "oxfmt" } }
		}
	}
}
